# Copy this file to .env at the repository root, edit model/checkpoint paths,
# then run: set -a; source .env; set +a
# MCOT_* setting names are retained for compatibility with existing commands.

# Every dataset/input/output-data path is relative to this root by default.
MCOT_DATA_ROOT=$PWD/data

# Optional dedicated Python/conda environment. Leave unset when the active
# environment already contains the reference dependencies.
QWENVL_ENV_DIR=/path/to/qwenvl-environment

# Shared inputs
MIMIC_CXR_ROOT=$MCOT_DATA_ROOT/images
MCOT_BASE_MODEL=/path/to/Qwen3-VL-4B-Instruct
MCOT_BASE_RECORDS=$MCOT_DATA_ROOT/source/base_records.json
FEW_SHOT_EXAMPLES=$MCOT_DATA_ROOT/source/few_shot_examples.json
MCOT_REFERENCE_REPORTS=$MCOT_DATA_ROOT/source/reference_reports.json
MCOT_CLINICAL_CONTEXT=$MCOT_DATA_ROOT/source/clinical_context.json
MCOT_ANATOMY_SOURCE=$MCOT_DATA_ROOT/source/anatomy_boxes.json
MCOT_PIPELINE_WORK_DIR=$MCOT_DATA_ROOT/work/pipeline

# SFT
MCOT_ANNOTATION_PATH=$MCOT_DATA_ROOT/mcot_annotation.json
MCOT_SFT_OUTPUT_DIR=/path/to/outputs/ARIVE-sft
MCOT_SFT_DATASET_NAME=MIMIC_COT

# GRPO
MCOT_ABNORMAL_ANNOTATION_PATH=$MCOT_DATA_ROOT/abnormal_mcot_annotation.json
MCOT_SFT_MODEL_PATH=/path/to/outputs/ARIVE-sft
MCOT_VLLM_MODEL_PATH=/path/to/outputs/ARIVE-sft-vllm
MCOT_GRPO_OUTPUT_DIR=/path/to/outputs/ARIVE-grpo
MCOT_GRPO_DATASET_NAME=ABN_MIMIC_COT
QWENVL_CHEXBERT_BERT_PATH=bert-base-uncased
QWENVL_CHEXBERT_CKPT_PATH=/path/to/chexbert.pth
QWENVL_REASONING_CHEXBERT_CKPT_PATH=/path/to/reasoning_chexbert.pth
QWENVL_RADGRAPH_MODEL_CACHE_DIR=/path/to/radgraph-cache
# bbox, reasoning CheXbert, answer CheXbert, answer RadGraph
QWENVL_GRPO_REWARD_WEIGHTS=0.25,0.25,0.25,0.25

# Inference
QWENVL_INFER_REPORT_PATH=$MCOT_DATA_ROOT/inference/evaluation_reports.jsonl
# Full corpus for resolving prior findings; it may equal REPORT_PATH.
QWENVL_INFER_REFERENCE_REPORT_PATH=$MCOT_DATA_ROOT/inference/reference_reports.jsonl
QWENVL_INFER_CLINICAL_CONTEXT_PATH=$MCOT_DATA_ROOT/inference/clinical_context.json
QWENVL_INFER_MIMIC_CXR_ROOT=$MCOT_DATA_ROOT/images
QWENVL_INFER_BASE_MODEL=/path/to/Qwen3-VL-4B-Instruct
QWENVL_INFER_VISION_CHECKPOINT=/path/to/ARIVE
QWENVL_INFER_VLLM_CHECKPOINT=/path/to/ARIVE-vllm
QWENVL_INFER_OUTPUT_DIR=/path/to/predictions
# The plural names are retained for compatibility; each accepts one value only.
QWENVL_INFER_TEMPERATURES=0.7
QWENVL_INFER_TOP_P=0.8
QWENVL_INFER_TOP_K=-1
QWENVL_INFER_PRESENCE_PENALTIES=1.5
QWENVL_INFER_SEED=3407
# Set to 1 only when existing prediction files may be replaced.
QWENVL_INFER_OVERWRITE=0

# MIMIC-ABN inference (inference/infer_mcot_abn.py).
# Replace QWENVL_INFER_REPORT_PATH above with this ABN evaluation JSONL before
# running the ABN entry point; the two annotations have distinct roles.
# QWENVL_INFER_REPORT_PATH=$MCOT_DATA_ROOT/inference/mimic_abn_evaluation_reports.jsonl
QWENVL_INFER_ABN_ANNOTATION_PATH=$MCOT_DATA_ROOT/inference/priorrg_mimic_abn_annotation.json
QWENVL_INFER_PRIOR_ANNOTATION_PATH=$MCOT_DATA_ROOT/inference/priorrg_mimic_cxr_annotation.json
# Set to 1 to validate ABN joins/images without importing Torch or vLLM.
QWENVL_INFER_PREFLIGHT_ONLY=0
